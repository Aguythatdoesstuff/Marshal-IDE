using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text.Json;

namespace Compiler
{
    public interface IValidator
    {
        bool Validate(string filePath, out string error);
    }

    public class ValidationResult
    {
        public bool IsValid { get; set; }
        public List<string> Errors { get; } = new List<string>();
    }

    // Base validator responsible for checking incoming absolute file paths,
    // delegating per-extension validation to specialized validators and
    // invoking a compiler callback when everything is valid.
    public class BaseValidator
    {
        private readonly Dictionary<string, IValidator> _validators;
        private readonly IValidator _fallbackValidator = new PassthroughValidator();

        public BaseValidator()
        {
            _validators = new Dictionary<string, IValidator>(StringComparer.OrdinalIgnoreCase);

            // Register a few common validators for local/dev testing
            RegisterValidator(".cs", new CSharpValidator());
        }

        public void RegisterValidator(string extension, IValidator validator)
        {
            if (string.IsNullOrWhiteSpace(extension)) throw new ArgumentException("extension");
            if (!extension.StartsWith(".")) extension = "." + extension;
            _validators[extension] = validator ?? throw new ArgumentNullException(nameof(validator));
        }

        // Process an enumerable of absolute file paths and return a ValidationResult
        public ValidationResult ProcessFiles(IEnumerable<string> absolutePaths)
        {
            var result = new ValidationResult { IsValid = true };

            if (absolutePaths == null)
            {
                result.IsValid = false;
                result.Errors.Add("No files provided.");
                return result;
            }

            foreach (var path in absolutePaths)
            {
                if (string.IsNullOrWhiteSpace(path))
                {
                    result.IsValid = false;
                    result.Errors.Add("Empty path provided.");
                    continue;
                }

                if (!Path.IsPathRooted(path))
                {
                    result.IsValid = false;
                    result.Errors.Add($"Path is not absolute: {path}");
                    continue;
                }

                if (!File.Exists(path))
                {
                    result.IsValid = false;
                    result.Errors.Add($"File not found: {path}");
                    continue;
                }

                var ext = Path.GetExtension(path);
                var validator = _validators.ContainsKey(ext) ? _validators[ext] : _fallbackValidator;

                if (!validator.Validate(path, out var error))
                {
                    result.IsValid = false;
                    result.Errors.Add(string.IsNullOrEmpty(error) ? $"Validation failed: {path}" : $"{path}: {error}");
                }
            }

            return result;
        }

        // Tries to validate and, if successful, invokes onAllValid with the original paths.
        // Returns true when validation passed and the callback was invoked.
        public bool TryValidateAndRun(IEnumerable<string> absolutePaths, Action<IEnumerable<string>> onAllValid)
        {
            var result = ProcessFiles(absolutePaths);
            if (!result.IsValid)
            {
                foreach (var e in result.Errors)
                {
                    Console.WriteLine("Validation error: " + e);
                }
                return false;
            }

            onAllValid?.Invoke(absolutePaths);
            return true;
        }

        // --- Simple validators used for local development / testing ---
        private class PassthroughValidator : IValidator
        {
            public bool Validate(string filePath, out string error)
            {
                error = null;
                return true;
            }
        }

        private class CSharpValidator : IValidator
        {
            public bool Validate(string filePath, out string error)
            {
                error = null;
                try
                {
                    var content = File.ReadAllText(filePath);
                    if (string.IsNullOrWhiteSpace(content))
                    {
                        error = "File is empty.";
                        return false;
                    }

                    // Basic heuristics: require at least one of these tokens to look like C# source.
                    if (!(content.Contains("namespace") || content.Contains("class") || content.Contains("using ")))
                    {
                        error = "Does not look like C# source (missing namespace/class/using).";
                        return false;
                    }

                    return true;
                }
                catch (Exception ex)
                {
                    error = ex.Message;
                    return false;
                }
            }
        }

        private class JsonValidator : IValidator
        {
            public bool Validate(string filePath, out string error)
            {
                error = null;
                try
                {
                    var content = File.ReadAllText(filePath);
                    if (string.IsNullOrWhiteSpace(content))
                    {
                        error = "File is empty.";
                        return false;
                    }

                    // Use System.Text.Json to validate JSON structure
                    using var doc = JsonDocument.Parse(content);
                    return true;
                }
                catch (Exception ex)
                {
                    error = "Invalid JSON: " + ex.Message;
                    return false;
                }
            }
        }
    }
}
