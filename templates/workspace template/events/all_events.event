
country event shadow_company_attacks.1
    title "Shadow corp INC DDOS atack!"
    desc "The shadow company is DDOSING our servers!"
    sprite "GFX_report_event_generic_read_write"
    option "FUCK"
        add_to_variable = { breach_progress = 8 } # how close they to hacking us

country event shadow_company_attacks.2
    title "Shadow corp INC encryption upgrade!"
    desc "The shadow company has upgraded theire encription tech! it will be harder to hack them now!"
    sprite "GFX_report_event_generic_read_write"
    option "FUCK"
        add_to_variable = { offense_bar = -8 } # how close we to hacking them

country event shadow_company_attacks.3
    title "Shadow corp INC pop-up spam!"
    desc "A massive wave of high-resolution ads for 'Krabby Patties' has frozen our UI!"
    sprite "GFX_report_event_generic_read_write"
    option "FUCK"
        add_to_variable = { breach_progress = 5 }

country event shadow_company_attacks.4
    title "Shadow corp INC ransomware!"
    desc "The Shadow Company has encrypted our division templates! Pay in Bitcoin to unlock."
    sprite "GFX_report_event_generic_read_write"
    option "FUCK"
        add_to_variable = { offense_bar = -10 }

country event shadow_company_attacks.5
    title "Shadow corp INC social engineering!"
    desc "An intern clicked a link promising 'Free Arch Linux ISOs.' It was a trap."
    sprite "GFX_report_event_generic_read_write"
    option "FUCK"
        add_to_variable = { breach_progress = 12 }

country event shadow_company_attacks.6
    title "Shadow corp INC data leak!"
    desc "Your_mom.png has been leaked to the public servers! The sheer mass is slowing everything down!"
    sprite "GFX_report_event_generic_read_write"
    option "FUCK"
        add_to_variable = { offense_bar = -5 }

country event shadow_company_attacks.7
    title "Shadow corp INC logic bomb!"
    desc "They sent a code block with a missing bracket. Our CPUs are crying."
    sprite "GFX_report_event_generic_read_write"
    option "FUCK"
        add_to_variable = { breach_progress = 15 }

country event shadow_company_attacks.8
    title "Shadow corp INC crypto-miner!"
    desc "Shadow Corp is using our military factories to mine 'DogeCoin'!"
    sprite "GFX_report_event_generic_read_write"
    option "FUCK"
        add_to_variable = { offense_bar = -12 }

country event shadow_company_attacks.9
    title "Shadow corp INC cringe department!"
    desc "The Shadow Company CEO just posted a TikTok. Our stability is plummeting from the cringe."
    sprite "GFX_report_event_generic_read_write"
    option "FUCK"
        add_to_variable = { breach_progress = 7 }

country event shadow_company_attacks.10
    title "Shadow corp INC firewall breach!"
    desc "They found the 'special' folder! They are laughing at us!"
    sprite "GFX_report_event_generic_read_write"
    option "FUCK"
        add_to_variable = { breach_progress = 15 }

country event response.1
    title "Leader Caught Clicking Scam Ad!"
    desc "OUR 'GREAT' LEADER WAS CAUGHT BEING SCAMMED BY A AD POPPUP!"
    sprite "GFX_report_event_generic_read_write"
    option "FUCK"
        add_stability = -0.05
        add_timed_idea = {
            idea = "leader_dumbass"
            days = 70
        }

country event response.2
    title "Leader Buys 'Secret War Plans' PDF"
    desc "Our glorious leader saw an ad claiming to sell 'The Shadow Company's Entire Strategy' for the low price of 9.99. They entered the national treasury's credit card details. We didn't get a PDF; we got a picture of a middle finger."
    sprite "GFX_report_event_generic_read_write"
    option "How could you be so gullible?"
        add_political_power = -50
        add_timed_idea = {
            idea = "national_laughing_stock"
            days = 60
        }

country event response.3
    title "The 'Enlarge Your Manpower' Pill"
    desc "A pop-up promised a revolutionary new supplement to 'Increase Division Size Overnight.' The leader clicked it, and now our high command's email inboxes are filled with spam for questionable pharmaceuticals. The Shadow Company is likely tracking every click."
    sprite "GFX_report_event_generic_read_write"
    option "It's for... medical research."
        add_stability = -0.05
        add_timed_idea = {
            idea = "command_distraction"
            days = 30
        }

country event response.4
    title "Leader Wins a 'Free' Aircraft Carrier"
    desc "An ad featuring a spinning gold star claimed our leader was the 'Lucky Winner' of a heavy carrier. To claim it, they just had to 'verify' our naval encryption codes. The Shadow Company now has our frequency hops, and we still have no carrier."
    sprite "GFX_report_event_generic_read_write"
    option "The 'Claim' button looked so real!"
        add_timed_idea = {
            idea = "leader_dumbass"
            days = 70
        }
        
country event response.5
    title "Accidental 'Reply All' to a Prince"
    desc "A 'Shadow-Prince' emailed promising a fortune if we helped move money out of the country. The leader not only replied but accidentally 'Replied All' to every diplomatic mission in the world with their bank login."
    sprite "GFX_report_event_generic_read_write"
    option "Cancel the credit cards. All of them."
        add_political_power = -100
        add_stability = -0.1
        add_timed_idea = {
            idea = "leader_dumbass"
            days = 70
        }

country event game_result.1
    title "A Decisive Success"
    desc "Our meticulous planning has paid off. The objectives have been secured, and the initiative remains firmly in our hands."
    sprite "GFX_report_event_generic_handshake"
    option "The wheels of progress turn."

country event game_result.2
    title "Strategic Setback"
    desc "Despite our best efforts, the situation has slipped from our control. We must now deal with the fallout of this administrative failure."
    sprite "GFX_report_event_generic_handshake"
    option "A bitter pill to swallow."

country event won_war_on_ads.1
    title "The Firewall Crumbles"
    desc "The final handshake has been bypassed. Our counter-probes have successfully infiltrated the Shadow Company’s central nervous system, turning their aggressive marketing algorithms into our own private revenue streams. As their servers go dark, their offshore accounts are being drained into our national treasury. The 'unskippable' era is over, the data belongs to us now."
    sprite "GFX_report_event_generic_handshake"
    option "Delete their legacy."
        add_ideas = won_war_on_ads
        add_offsite_building = { type = industrial_complex level = 10 }
        add_political_power = 200
        add_war_support = 0.1
        add_stability = 0.1

country event lost_war_on_ads.1
    title "Systemic Hostile Takeover"
    desc "Our encryption was insufficient. The Shadow Company didn't just win, they've integrated us. Our national economy is now being treated as a subsidiary of their global marketing network. Every transaction, every broadcast, and every movement is now taxed by an invisible board of directors. We aren't a nation anymore, we're an audience."
    sprite "GFX_report_event_generic_handshake"
    option "Terms and Conditions accepted."
        add_ideas = lost_war_on_ads
        add_political_power = -200
        add_war_support = -0.1
        add_stability = -0.1