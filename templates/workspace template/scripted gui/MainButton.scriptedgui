window "open_main_window"
    size x50 y50
    position x93 y8     
    visible
        not
            has_country_flag = already_shown_the_result
    button
        sprite "GFX_mod_menu_button"
        position x570 y32
        on click
            if
                has_country_flag = open_war_on_ads_gui
                then
                    clr_country_flag = open_war_on_ads_gui
            else
                random_text = yes
                set_country_flag = open_war_on_ads_gui