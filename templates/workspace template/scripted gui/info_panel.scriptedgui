draggable window "info_panel"
    size x900 y500 
    position x500 y270
    sprite "GFX_tiled_window"
    visible
        has_country_flag = open_info_panel

    # Window Title
    text
        text "§HWAR ON ADS: COMMAND BRIEFING§"
        font "hoi_36header"
        position x250 y10
        max size x600 y30

    button
        sprite "GFX_closebutton"
        position x865 y2 
        on click
            clr_country_flag = open_info_panel

    # --- CONTENT OF INFO PANEL ---
    
    # Section 1: Objective
    text
        text "§H1. OBJECTIVE: TOTAL AD DOMINANCE§"
        font "hoi_20b"
        position x50 y70
        max size x500 y20

    text
        text "Shadow Co. is trying to compromise our digital sovereignty. Initiate the 'Hack Company' operation to breach their servers. Upon reaching §G100% Breach Progress§, you will secure their funds, gain political power, and permanently remove all ad-related debuffs."
        font "hoi_16mbs"
        position x60 y100
        max size x815 y20

    # Section 2: Defense
    text
        text "§H2. DEFENCE: FIREWALL INTEGRITY§"
        font "hoi_20b"
        position x50 y180
        max size x500 y20

    text
        text "Use the 'Upgrade Firewall' action to reduce the frequency of popup ads and mitigate negative National Spirit debuffs. A higher version increases overall resistance."
        font "hoi_16mbs"
        position x60 y210
        max size x815 y20
        
        
    # Section 3: Threat
    text
        text "§H3. THREAT: ENEMY BREACH§"
        font "hoi_20b"
        position x50 y280
        max size x500 y20

    text
        text "Monitor your 'Server Integrity'. If Shadow Co. reaches §R100% Breach Progress§ on you, they will hack your country, resulting in a name change, massive penalties, and redirection of your national funds to them."
        font "hoi_16mbs"
        position x60 y310
        max size x815 y20

    # Section 4: Mechanics
    text
        text "§H4. COMMAND ACTIONS: MINIGAMES§"
        font "hoi_20b"
        position x50 y400
        max size x500 y20

    text
        text "Click 'Hack Company' to initiate a tactical minigame. Winning provides significant advantages. However, be advised: exiting the minigame early will cause you to lose invested resources with no gain."
        font "hoi_16mbs"
        position x60 y430
        max size x815 y20