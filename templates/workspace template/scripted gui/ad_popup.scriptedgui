        # Fallback for safety, because if the games all the other checks fails and we dont add this the game will not be happy and either crash or show the GFX not found doggo
draggable window "ad_manager_gui"
    size x1573 y900
    position x130 y85     
    sprite "GFX_tiled_window"
    visible
        has_country_flag = open_ad1
    icon
        sprite get_random_image_loc
        position x18 y18
        size 80%
    button
        sprite "GFX_closebutton"
        position x1537 y2 
        on click
            clr_country_flag = open_ad1
    button
        sprite "GFX_button_clickme"
        position x520 y738
        size 120% 
        on click
            click_me_button_ad_effects = yes
            