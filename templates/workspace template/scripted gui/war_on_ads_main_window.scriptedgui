        then
            text "Shadow Corp is watching you. They think your playstyle is 'Mid'."
    else if
        check_variable = { text = 186 }
        then
            text "Is it too late to become a farmer? This coding thing is hard."
    else if
        check_variable = { text = 187 }
        then
            text "I'm not a bot, I'm just a very tired human with a lot of C# scripts."
    else if
        check_variable = { text = 188 }
        then
            text "End of the line. Go play the actual game now."
    else if
        check_variable = { text = 189 }
        then
            text "Why is the GUI shaking? Is it cold? Do I need to feed the GPU more RAM?"
    else if
        check_variable = { text = 190 }
        then
            text "I'm not saying it's a virus, but your CPU fan just started playing the Imperial March."
    else if
        check_variable = { text = 191 }
        then
            text "Error: User attempted to use logic in a Clausewitz engine mod. Logic.dll not found."
    else if
        check_variable = { text = 192 }
        then
            text "If you find a bracket '{' lying around, please return it. I'm missing about 400."
    else if
        check_variable = { text = 193 }
        then
            text "Napoleon once said: 'Never interrupt your enemy when he is making a mistake.' So I'll let you keep clicking."
    else if
        check_variable = { text = 194 }
        then
            text "Wait, if this is the War on Ads, where is the 'Skip Ad' button? Oh right, I forgot to code it."
    else if
        check_variable = { text = 195 }
        then
            text "Don't worry, the 1GB file size is just for 'immersion'."
    else if
        check_variable = { text = 196 }
        then
            text "My favorite Linux distro is whatever one doesn't make me want to cry (So, not Arch)."
    else if
        check_variable = { text = 197 }
        then
            text "What if the real Shadow Corp was the variables we made along the way?"
    else if
        check_variable = { text = 198 }
        then
            text "I asked my RAM if it was okay. It just screamed in Hexadecimal."
    else if
        check_variable = { text = 199 }
        then
            text "This mod is brought to you by 3 hours of sleep and a lukewarm Monster Energy."
    else if
        check_variable = { text = 200 }
        then
            text "Current Mood: Attempting to solve a P=NP problem with a 'random_list' block."
    else if
        check_variable = { text = 201 }
        then
            text "Is it 'Gray' or 'Grey'? Either way, the buttons are definitely Green."
    else if
        check_variable = { text = 202 }
        then
            text "Fun Fact: This specific line of text cost you 4MB of VRAM for no reason."
    else if
        check_variable = { text = 203 }
        then
            text "I have 99 problems and a missing semicolon is at least 98 of them."
    else if
        check_variable = { text = 204 }
        then
            text "Warning: Shadow Corp has detected that you haven't updated your WinRAR since 2004."
    else if
        check_variable = { text = 205 }
        then
            text "The Krabby Patty secret formula is actually just 10,000 lines of nested if-statements."
    else if
        check_variable = { text = 206 }
        then
            text "If the game crashes now, it was a 'creative choice' by the developer."
    else if
        check_variable = { text = 207 }
        then
            text "Steiner's counter-attack will fix the file size issues."
    else if
        check_variable = { text = 208 }
        then
            text "Look behind you! A three-headed monkey! (And a 1900x1300 SpongeBob)."
    else if
        check_variable = { text = 209 }
        then
            text "Why do they call it 'IDE' when I spend all my time 'I-D-Eing' inside?"
    else if
        check_variable = { text = 210 }
        then
            text "System Log: 12:00:01 - User is still clicking. 12:00:02 - User is still clicking. 12:00:03 - Pain."
    else if
        check_variable = { text = 211 }
        then
            text "I'd tell you a joke about UDP, but you might not get it."
    else if
        check_variable = { text = 212 }
        then
            text "I'd tell you a joke about TCP, but I'd have to keep repeating it until you acknowledged it."
    else if
        check_variable = { text = 213 }
        then
            text "Instruction Manual: Step 1: Click button. Step 2: ??? Step 3: Profit."
    else if
        check_variable = { text = 214 }
        then
            text "Shadow Corp is currently downloading your search history. They are very disappointed."
    else if
        check_variable = { text = 215 }
        then
            text "Does this GUI make my variables look fat?"
    else if
        check_variable = { text = 216 }
        then
            text "If you can read this, you aren't micro-managing your front line. Get back to work."
    else if
        check_variable = { text = 217 }
        then
            text "One does not simply 'walk' into a 1GB mod folder."
    else if
        check_variable = { text = 218 }
        then
            text "This mod is 10% code, 90% SpongeBob, and 100% reason to remember the name."
    else if
        check_variable = { text = 219 }
        then
            text "End of Log. Please insert Disc 2 to continue."
    else
        text "You a UNC!"


# --- MAIN GUI WINDOW ---
draggable window "war_on_ads_gui"
    size x900 y700 # Reduced height slightly for better layout
    position x500 y220
    sprite "GFX_tiled_window"
    visible
        has_country_flag = open_war_on_ads_gui

    #meme text
    text
        text random_yap_bullshit
        font "hoi_36header"
        position x100 y450
        max size x700 y600
    # Window Title
    text
        text "§HWAR ON ADS§"
        font "hoi_36header"
        position x380 y10
        max size x400 y30
        
    button
        sprite "GFX_closebutton"
        position x865 y2 
        on click
            clr_country_flag = open_war_on_ads_gui

    # --- INFO / HELP BUTTON ---
    button
        sprite "GFX_help_button"
        position x0 y2
        size 120%
        on click
            set_country_flag = open_info_panel
            
        # Add your tooltip here
        
    # ==========================================
    # --- DEFFENCE (LEFT PANEL) ---
    # ==========================================
    icon
        sprite "GFX_tiled_window_transparent"
        position x50 y70
        size x380 y250

    text
        text "§RDEFENCE SYSTEMS§"
        font "hoi_36header"
        position x70 y80
        max size x300 y30
    # ==========================================
    # --- SERVER INTEGRITY (BOTTOM PANEL) ---
    # ==========================================
    icon
        sprite "GFX_tiled_window_transparent"
        position x50 y350
        size x800 y150

# breach progress bar
    icon
        sprite "GFX_pol_goal_progress_frame"
        position x68 y182

    horizontal bar with 100 steps
        #full bar sprite "gfx/interface/pol_goal_progress.dds"
        #empty bar sprite "gfx/interface/pol_goal_progress_bg.dds"
        unprogressed color 0.3 0.0 0.0 # Dark Red
        progressed color 0.6 0.0 0.0 # Red (danger)
        var "breach_progress"
        position x70 y183   
        size x235 y4

    button
        sprite "GFX_button_123x34"
        position x50 y200
        text "Fix Vulnerability"
        font "hoi_16mbs"
        on click        
            if
                has_political_power > 49
                num_of_civilian_factories > 1
                then 
                    if
                        has_country_flag = has_minigame
                        then
                            #do nothing cuz you cant open 2 games at once
                    else
                        set_variable = { button_action = 1 }
                        add_political_power = -50
                        add_timed_idea = {
                            idea = "basic_action"
                            days = 60
                        }
                        open_random_minigame = yes
                        
    #  PRICES PP
    text
        static tooltip "political power cost"
        text price_button_basic_pp
        font "hoi_36header"
        position x105 y238
        max size x50 y36
    icon
        static tooltip "political power cost"
        sprite "GFX_pol_power_icon"
        position x75 y242
    #  PRICES CIVS
    text
        static tooltip "civilian factories cost"
        text price_button_basic_eco
        font "hoi_36header"
        position x105 y270
        max size x50 y36
    icon
        static tooltip "civilian factories cost"
        sprite "GFX_industrial_capacity_icon"
        position x70 y274

    button
        sprite "GFX_button_123x34"
        position x220 y200
        text "Restore Backup"
        font "hoi_16mbs"
        on click       
            if
                    has_political_power > 99
                    num_of_civilian_factories > 3
                    then      
                        if
                            has_country_flag = has_minigame
                            then
                                #do nothing cuz you cant open 2 games at once
                        else
                            add_political_power = -100
                            add_timed_idea = {
                                idea = "premium_action"
                                days = 60
                            }
                            set_variable = { button_action = 2 }
                            open_random_minigame = yes
                            
    #  PRICES PP
    text
        static tooltip "political power cost"
        text price_button_premium_pp
        font "hoi_36header"
        position x280 y238
        max size x50 y36
    icon
        static tooltip "political power cost"
        sprite "GFX_pol_power_icon"
        position x250 y242
    #  PRICES CIVS
    text
        static tooltip "civilian factories cost"
        text price_button_premium_eco
        font "hoi_36header"
        position x280 y270
        max size x50 y36
    icon
        static tooltip "civilian factories cost"
        sprite "GFX_industrial_capacity_icon"
        position x245 y274
    # ==========================================
    # --- OFFENCE (RIGHT PANEL) ---
    # ==========================================
    icon
        sprite "GFX_tiled_window_transparent"
        position x470 y70

    text
        text "§ROFFENCE SYSTEMS§"
        font "hoi_36header"
        position x490 y80
        max size x300 y30


# offence progress bar
    icon
        sprite "GFX_pol_goal_progress_frame"
        position x490 y182 

    horizontal bar with 100 steps
        #full bar sprite "gfx/interface/pol_goal_progress.dds"
        #empty bar sprite "gfx/interface/pol_goal_progress_bg.dds"
        unprogressed color 0.3 0.0 0.0 # Dark Red
        progressed color 0.6 0.3 0.0 # Amber/Orange
        var "offense_bar"
        position x492 y183   
        size x235 y4

