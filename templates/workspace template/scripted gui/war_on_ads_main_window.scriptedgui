define text price_button_basic_pp
    if
        has_political_power > 49
        then
            text "§G50§"
    else
        text "§R50§"

define text price_button_premium_pp
    if
        has_political_power > 99
        then
            text "§G100§"
    else
        text "§R100§"

define text price_button_basic_eco
    if
        num_of_civilian_factories > 1
        then
            text "§G2§"
    else
        text "§R2§"

define text price_button_premium_eco
    if
        num_of_civilian_factories > 3
        then
            text "§G4§"
    else
        text "§R4§"