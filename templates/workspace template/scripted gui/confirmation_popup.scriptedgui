draggable window "confirmation_popup"                
    size x400 y200 
    position x550 y350                
    sprite "GFX_tiled_window"                
    visible                
        has_country_flag = open_confirmation_popup                

                      
    # Window Title                
    text                
        text "§HAre you sure?§"                
        font "hoi_36header"                
        position x90 y15                
        max size x600 y30                

    # Added Warning Text
    text
        text "Closing now will lose all progress, resources, and time invested. Do you still want to continue?"
        font "hoi_16mbs"
        position x30 y60
        max size x340 y100

    # Close X button
    button                
        sprite "GFX_closebutton"                
        position x365 y2  # Positioned to top right
        on click                
            clr_country_flag = open_confirmation_popup                

    # Yes Button
    button                
        text "Yes"                
        font "hoi_16mbs"                
        sprite "GFX_button_94x31"                
        position x70 y140 
        on click                            
            clr_country_flag = open_minigame_1 
            clr_country_flag = has_minigame               
            clr_country_flag = open_confirmation_popup                

    # No Button
    button                
        text "No"                
        font "hoi_16mbs"                
        sprite "GFX_button_94x31"                
        position x230 y140 
        on click                
            clr_country_flag = open_confirmation_popup