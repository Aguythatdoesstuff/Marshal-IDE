# --- MAIN GUI WINDOW ---
draggable window "minigame_1"
    size x700 y600 # Reduced height slightly for better layout
    position x430 y270
    sprite "GFX_tiled_window"
    visible
        has_country_flag = open_minigame_1

    # Window Title
    text
        text "§HWAR ON ADS MINIGAME§"
        font "hoi_36header"
        position x200 y10
        max size x400 y30

    button
        sprite "GFX_closebutton"
        position x665 y2 
        on click
            set_country_flag = open_confirmation_popup

    # --- INFO / HELP BUTTON ---
    button
        sprite "GFX_help_button"
        position x0 y2
        size 120%
        on click
            set_country_flag = open_info_panel_minigame_1
        # Add your tooltip here

# timer
    text
        text "§BTime left§"
        font "hoi_20b"
        position x320 y50

    icon
        sprite "GFX_pol_goal_progress_frame"
        position x233 y75 
        size 100%

    horizontal bar with 70 steps
        #full bar sprite "gfx/interface/pol_goal_progress.dds"
        #empty bar sprite "gfx/interface/pol_goal_progress_bg.dds"
        unprogressed color 0.0 0.0 0.3
        progressed color 0.0 0.0 0.7
        var "time_left"
        position x235 y76   
        size x235 y4
        
    # done in
    text
        text "§GDone in§"
        font "hoi_20b"
        position x320 y90
        
    icon
        sprite "GFX_pol_goal_progress_frame"
        position x233 y115 
        size 100%

    horizontal bar with 80 steps
        #full bar sprite "gfx/interface/pol_goal_progress.dds"
        #empty bar sprite "gfx/interface/pol_goal_progress_bg.dds"
        unprogressed color 0.0 0.3 0.0
        progressed color 0.0 0.7 0.0
        var "done_in"
        position x235 y116   
        size x235 y4

    # ----- ALL THE buttons!!!! ------

    # DB Core
    text
        text button1_text
        font "hoi_20b"
        position x127 y175
    icon
        sprite button1_gfx
        position x110 y200 
    button
        text enable_or_disable_button1
        font "hoi_16mbs"
        sprite "GFX_button_94x31"
        position x110 y200 
        on click
            set_variable = {button1_enabled = 1}



