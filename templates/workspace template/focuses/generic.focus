            add_stability = 0.10

# --- RADICAL JUNTA (MILITARY DIRECTIVE) BRANCH ---

    focus radical_junta_path takes 70 days
        name "The Military Directive"
        sprite "GFX_focus_generic_military_dictatorship"
        require political_effort
        prevents pro_west_path
            pro_east_path
            neutral_path
        follow position of political_effort
        position x12 y1
        on complete
            set_politics = { ruling_party = fascism }
            add_political_power = 50

    # --- ROW 1: CONSOLIDATING THE COUP ---

    focus stabilize_the_regime takes 70 days
        name "Stabilize the Regime"
        sprite "GFX_focus_GER_the_supreme_leader"
