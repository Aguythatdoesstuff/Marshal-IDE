            add_tech_bonus = { name = electronics_tech bonus = 1.0 }

    focus promote_nationalism takes 70 days
        name "Promote Civic Nationalism"
        sprite "GFX_focus_NOR_the_lone_wolf_norway"
        require the_middle_way
        follow position of the_middle_way
        position x-1 y1
        on complete
            add_war_support = 0.10
            add_stability = 0.05

    focus civilian_defense_drills takes 70 days
        name "Civilian Defense Drills"
        sprite "GFX_focus_generic_the_giant_wakes"
        require the_middle_way
        follow position of the_middle_way
        position x1 y1
        on complete
            add_war_support = 0.10
            add_command_power = 20

    focus the_impassable_border takes 70 days
        name "The Impassable Border"
        require border_fortifications
        follow position of border_fortifications
        position x0 y1
        on complete
