default tree generic_focus
    name "Smart Generic Focus Tree"
    desc "A dynamic tree that adapts to the nation's geopolitical situation."
    reset_on_civilwar = no
    initial_show_position = {
        focus = political_effort
    }

    # --- POLITICAL BRANCH ---

    focus political_effort takes 10 days
        name "Address the Political Crisis"
        desc "Our nation stands at a crossroads. We must choose a direction."
        sprite "GFX_goal_generic_political_pressure"
        position x24 y0
        on complete
            add_political_power = 50

# --- THE ATLANTIC OUTREACH (PRO-WEST) BRANCH ---

    focus pro_west_path takes 70 days
        name "The Atlantic Outreach"
        sprite "GFX_focus_generic_approach_the_west"
        require political_effort
        prevents pro_east_path
            neutral_path
            radical_junta_path
        follow position of political_effort
        position x-12 y1
        on complete
            add_popularity = {
                ideology = democratic
                popularity = 0.5
            } 

    # --- ROW 1: WESTERN INTEGRATION ---

    focus democratic_reforms takes 70 days
        name "Institutional Democratic Reforms"
        sprite "GFX_focus_ICE_republicanism"
        require pro_west_path
        follow position of pro_west_path
        position x-2 y1
        on complete
            add_political_power = 100
            add_stability = 0.05

    focus nato_partnership_prog takes 70 days
        name "NATO Partnership for Peace"
        sprite "GFX_focus_generic_treaty"
        require pro_west_path
        follow position of pro_west_path
        position x0 y1
        on complete
            add_command_power = 20
            army_experience = 10

    focus eu_association_agreement takes 70 days
        name "EU Association Agreement"
        sprite "GFX_focus_generic_the_council_of_europe"
        require pro_west_path
        follow position of pro_west_path
        position x2 y1
        on complete
            add_offsite_base_ic = 1
            add_political_power = 50

    # --- ROW 2: LIBERALIZATION & SECURITY ---

    focus judicial_independence takes 70 days
        name "Judicial Independence Act"
        sprite "GFX_focus_generic_improve_the_administration_2"
        require democratic_reforms
        follow position of democratic_reforms
        position x-1 y1
        on complete
            add_stability = 0.10

    focus joint_nato_training takes 70 days
        name "Joint NATO Training Centers"
        sprite "GFX_focus_generic_military_mission"
        require nato_partnership_prog
        follow position of nato_partnership_prog
        position x0 y1
        on complete
            add_tech_bonus = { name = land_doc_bonus bonus = 1.0 }
            army_experience = 20

    focus free_trade_negotiations takes 70 days
        name "Western Free Trade Negotiations"
        sprite "GFX_goal_generic_trade"
        require eu_association_agreement
        follow position of eu_association_agreement
        position x1 y1
        on complete
            add_offsite_base_ic = 1

    # --- ROW 3: MODERNIZATION & ALIGNMENT ---

    focus anti_corruption_taskforce takes 70 days
        name "Anti-Corruption Taskforce"
        sprite "GFX_focus_NOR_restore_public_trust_in_the_storting"
        require judicial_independence
        follow position of judicial_independence
        position x0 y1
        on complete
            add_stability = 0.05
            add_political_power = 50

    focus western_arms_procurement takes 70 days
        name "Western Arms Procurement"
        sprite "GFX_goal_generic_military_deal"
        require joint_nato_training
        follow position of joint_nato_training
        position x-1 y1
        on complete
            army_experience = 25
            add_command_power = 15

    focus intel_sharing_network takes 70 days
        name "Five Eyes Data Sharing"
        sprite "GFX_goal_generic_intelligence_exchange"
        require joint_nato_training
        follow position of joint_nato_training
        position x1 y1
        on complete
            add_tech_bonus = { name = electronics_tech bonus = 1.0 }

    focus foreign_direct_investment takes 70 days
        name "Encourage Western FDI"
        sprite "GFX_focus_ETH_invest_in_the_west"
        require free_trade_negotiations
        follow position of free_trade_negotiations
        position x0 y1
        on complete
            add_offsite_base_ic = 2

    # --- ROW 4: ATLANTIC BASTION (CHOKEPOINT) ---

    focus atlantic_integration takes 70 days
        name "Full Atlantic Integration"
        sprite "GFX_goal_generic_major_alliance"
        require anti_corruption_taskforce
            western_arms_procurement
            intel_sharing_network
            foreign_direct_investment
        follow position of nato_partnership_prog
        position x0 y3
        on complete
            add_political_power = 100
            add_stability = 0.05

    # --- ROW 5: STRATEGIC ALLIANCE FINISHERS ---

    focus major_non_nato_ally takes 70 days
        name "Major Non-NATO Ally Status"
        sprite "GFX_goal_generic_alliance"
        require atlantic_integration
        follow position of atlantic_integration
        position x-1 y1
        on complete
            add_command_power = 50
            add_war_support = 0.10

    focus common_market_access takes 70 days
        name "Common Market Access"
        sprite "GFX_goal_generic_positive_trade_relations"
        require atlantic_integration
        follow position of atlantic_integration
        position x1 y1
        on complete
            add_offsite_base_ic = 3

    focus western_shield takes 70 days
        name "The Western Shield"
        sprite "GFX_goal_generic_defence"
        require major_non_nato_ally
            common_market_access
        follow position of atlantic_integration
        position x0 y2
        on complete
            add_stability = 0.15
            army_experience = 50

# --- THE EASTERN ALIGNMENT (PRO-EAST) BRANCH ---

    focus pro_east_path takes 70 days
        name "The Eastern Alignment"
        sprite "GFX_focus_generic_join_comintern"
        require political_effort
        prevents pro_west_path
            neutral_path
        follow position of political_effort
        position x-4 y1
        on complete
            add_popularity = {
                ideology = communism
                popularity = 0.5
            } 

    # --- ROW 1: EURASIAN INTEGRATION ---

    focus silk_road_initiative takes 70 days
        name "Join the Silk Road Initiative"
        sprite "GFX_focus_JAP_develop_the_yen_block"
        require pro_east_path
        follow position of pro_east_path
        position x-2 y1
        on complete
            add_offsite_base_ic = 1
            add_political_power = 50

    focus security_dialogue takes 70 days
        name "Eurasian Security Dialogue"
        sprite "GFX_goal_generic_diplomatic_treaty"
        require pro_east_path
        follow position of pro_east_path
        position x0 y1
        on complete
            add_political_power = 75
            add_command_power = 20

    focus energy_partnership takes 70 days
        name "Strategic Energy Partnership"
        sprite "GFX_focus_AUS_the_matzen_oil_fields"
        require pro_east_path
        follow position of pro_east_path
        position x2 y1
        on complete
            add_offsite_base_ic = 1

    # --- ROW 2: TECHNICAL & MILITARY COOPERATION ---

    focus digital_sovereignty takes 70 days
        name "Digital Sovereignty Cooperation"
        sprite "GFX_focus_generic_cryptologic_bomb"
        require silk_road_initiative
        follow position of silk_road_initiative
        position x-1 y1
        on complete
            add_tech_bonus = { name = computing_tech bonus = 1.0 }

    focus joint_military_exercises takes 70 days
        name "Joint Military Exercises"
        sprite "GFX_goal_generic_military_sphere"
        require security_dialogue
        follow position of security_dialogue
        position x0 y1
        on complete
            army_experience = 30
            add_war_support = 0.05

    focus pipeline_infrastructure takes 70 days
        name "Expand Pipeline Infrastructure"
        sprite "GFX_focus_generic_africa_infrastructure"
        require energy_partnership
        follow position of energy_partnership
        position x1 y1
        on complete
            add_offsite_base_ic = 2

    # --- ROW 3: DEPENDECY & SPECIALIZATION ---

    focus tech_transfer_east takes 70 days
        name "Eastern Tech Transfer"
        sprite "GFX_goal_generic_scientific_exchange"
        require digital_sovereignty
        follow position of digital_sovereignty
        position x0 y1
        on complete
            add_tech_bonus = { name = industry_tech bonus = 1.0 }

    focus arms_procurement_east takes 70 days
        name "Eastern Arms Procurement"
        sprite "GFX_goal_generic_small_arms"
        require joint_military_exercises
        follow position of joint_military_exercises
        position x-1 y1
        on complete
            army_experience = 25
            add_command_power = 20

    focus currency_swap_agreements takes 70 days
        name "Currency Swap Agreements"
        sprite "GFX_focus_CHI_promote_national_currency"
        require joint_military_exercises
        follow position of joint_military_exercises
        position x1 y1
        on complete
            add_political_power = 75

    focus specialized_export_zones takes 70 days
        name "Specialized Export Zones"
        sprite "GFX_focus_generic_africa_production"
        require pipeline_infrastructure
        follow position of pipeline_infrastructure
        position x0 y1
        on complete
            add_offsite_base_ic = 2

    # --- ROW 4: EURASIAN BLOC MEMBER (CHOKEPOINT) ---

    focus eurasian_bloc_integration takes 70 days
        name "Full Eurasian Integration"
        sprite "GFX_goal_generic_war_with_comintern"
        require tech_transfer_east
            arms_procurement_east
            currency_swap_agreements
            specialized_export_zones
        follow position of security_dialogue
        position x0 y3
        on complete
            add_stability = 0.05
            add_political_power = 100

    # --- ROW 5: STRATEGIC ALLIANCE FINISHERS ---

    focus intelligence_sharing_treaty takes 70 days
        name "Intelligence Sharing Treaty"
        sprite "GFX_focus_generic_polish_deal"
        require eurasian_bloc_integration
        follow position of eurasian_bloc_integration
        position x-1 y1
        on complete
            add_command_power = 30
            add_tech_bonus = { name = electronics_tech bonus = 1.0 }

    focus mutual_defense_pact takes 70 days
        name "Mutual Defense Pact"
        sprite "GFX_goal_molotov_ribbentrop_pact"
        require eurasian_bloc_integration
        follow position of eurasian_bloc_integration
        position x1 y1
        on complete
            add_war_support = 0.15
            add_political_power = 50

    focus the_eastern_bulwark takes 70 days
        name "The Eastern Bulwark"
        sprite "GFX_focus_ger_bulwark_against_bolshevism"
