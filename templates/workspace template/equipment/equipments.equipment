define type banana_equipment_equipment available from 1934
    sprite "archetype_banana"
    # internally its: type = <type>	   	# Internal type: what kind of unit can use this equipment
    for units 
        anti_air
        infantry #adding infantry type
    
    group_by = archetype
    
    interface_category = interface_category_land

    #Misc Abilities
    reliability = 0.8
    maximum_speed = 4

    #Defensive Abilities
    defense = 400
    breakthrough = 100
    hardness = 0
    armor_value = 0

    #Offensive Abilities
    soft_attack = 3
    hard_attack = 7
    ap_attack = 25
    air_attack = 19

    #Space taken in convoy
    lend_lease_cost = 3

    build_cost_ic = 4
    resources = {
        steel = 2
    }

