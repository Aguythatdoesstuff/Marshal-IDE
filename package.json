{
  "name": "marshal-ide",
  "version": "1.1.0",
  "productName": "Marshal IDE",
  "description": "Marshal IDE + MarshalScript Editor",
  "type": "module",
  "main": "./build/vite/main/index.cjs",
  "author": "Kacper Kocemba",
  "homepage": "https://github.com/Aguythatdoesstuff/Marshal-IDE",
  "license": "SEE LICENSE IN LICENSE.txt",
  "scripts": {
    "license-gen": "generate-license-file --input package.json --output licenses/THIRD-PARTY-LICENSES.txt --overwrite",
    "start": "electron-vite build && electron .",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:all": "electron-vite build && electron-builder --win --linux"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "chalk": "^5.0.0",
    "chokidar": "^3.6.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.6.2",
    "fs-extra": "^11.3.3",
    "inquirer": "^9.0.0",
    "js-yaml": "^4.1.1",
    "monaco-editor": "^0.52.0",
    "open": "^10.2.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^39.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.0.0",
    "generate-license-file": "^4.1.1",
    "sass": "^1.99.0",
    "vite": "^5.4.21",
    "vite-plugin-static-copy": "^3.4.0"
  },
  "build": {
    "appId": "com.kacper.marshalide",
    "productName": "Marshal IDE",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "build/vite/**/*",
      "package.json",
      "compilers/**/*",
      "docs/**/*",
      "templates/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Kacper Kocemba",
      "category": "Development",
      "icon": "build"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Aguythatdoesstuff",
      "repo": "Marshal-IDE"
    },
    "extraResources": [
      {
        "from": "licenses/",
        "to": "licenses"
      },
      {
        "from": "c#/published-components/",
        "to": "c#/published-components"
      },
      "LICENSE.txt"
    ]
  }
}
