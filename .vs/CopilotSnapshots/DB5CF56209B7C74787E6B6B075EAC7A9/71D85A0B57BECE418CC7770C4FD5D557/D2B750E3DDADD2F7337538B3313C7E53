using System;
using System.Collections.Generic;
using System.Linq;

namespace Compiler
{
    public class ParsedEquipmentFile
    {
        public string SourceFileName { get; set; } = string.Empty;
        public EquipmentMetadata Metadata { get; set; } = new EquipmentMetadata();
    }

    public class EquipmentParser : BaseParser
    {
        public EquipmentParser()
        {
            Compiler.Logging.Logger.LogComponent("Parser", "EquipmentParser initialized.");
        }

        public ParsedEquipmentFile LastParsedFile { get; private set; }

        public override void ParseFile(string filePath, string fileName, List<BaseValidator.PreprocessedLine> preprocessedLines)
        {
            try
            {
                var metadata = new EquipmentMetadata();

                foreach (var line in preprocessedLines)
                {
                    string trimmed = line.TrimmedLine.Trim();

                    if (string.IsNullOrWhiteSpace(trimmed) || trimmed == "}")
                        continue;

                    if (trimmed.StartsWith("define type "))
                    {
                        string content = trimmed.Substring("define type ".Length).Trim();
                        int availableFromIndex = content.IndexOf(" available from ", StringComparison.OrdinalIgnoreCase);
                        string typeId = availableFromIndex != -1
                            ? content.Substring(0, availableFromIndex).Trim()
                            : content.Trim();

                        metadata.Lines[line.LineNumber] = new EquipmentLineData
                        {
                            LineNumber = line.LineNumber,
                            Id = typeId,
                            Misc = string.Empty
                        };
                    }
                    else if (trimmed.StartsWith("equipment "))
                    {
                        string content = trimmed.Substring("equipment ".Length).Trim();
                        int availableFromIndex = content.IndexOf(" available from ", StringComparison.OrdinalIgnoreCase);
                        string equipmentId = availableFromIndex != -1
                            ? content.Substring(0, availableFromIndex).Trim()
                            : content.Trim();

                        metadata.Lines[line.LineNumber] = new EquipmentLineData
                        {
                            LineNumber = line.LineNumber,
                            Id = equipmentId,
                            Misc = string.Empty
                        };
                    }
                    else if (trimmed.StartsWith("name for ") || trimmed.StartsWith("desc for ") || trimmed.StartsWith("short desc for "))
                    {
                        string prefix = "";
                        if (trimmed.StartsWith("name for "))
                            prefix = "name for ";
                        else if (trimmed.StartsWith("desc for "))
                            prefix = "desc for ";
                        else if (trimmed.StartsWith("short desc for "))
                            prefix = "short desc for ";

                        string content = trimmed.Substring(prefix.Length).Trim();
                        int spaceIndex = content.IndexOf(' ');
                        string countryTag = spaceIndex != -1
                            ? content.Substring(0, spaceIndex).Trim()
                            : content.Trim();

                        metadata.Lines[line.LineNumber] = new EquipmentLineData
                        {
                            LineNumber = line.LineNumber,
                            Id = countryTag,
                            Misc = string.Empty
                        };
                    }
                }

                LastParsedFile = new ParsedEquipmentFile
                {
                    SourceFileName = fileName,
                    Metadata = metadata
                };

                Compiler.Logging.Logger.LogComponent("Parser", $"Equipment file parsed: {fileName}, {metadata.Lines.Count} definitions found.");
            }
            catch (Exception ex)
            {
                Errors.Add(new ParsingError(fileName, 0, $"ERROR! PARSER EXCEPTION: {ex.Message}"));
                Compiler.Logging.Logger.LogComponent("Parser", $"Equipment parsing error: {ex}");
            }
        }
    }
}
