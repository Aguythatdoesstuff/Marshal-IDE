define type anti_air_equipment available from 1934
    sprite "archetype_anti_air_equipment"
    for units # internally its: type = <type>	   	# Internal type: what kind of unit can use this equipment
        anti_air
        infantry #adding infantry type
    
    group_by = archetype
    
    interface_category = interface_category_land

    #Misc Abilities
    reliability = 0.8
    maximum_speed = 4

    #Defensive Abilities
    defense = 4
    breakthrough = 1
    hardness = 0
    armor_value = 0

    #Offensive Abilities
    soft_attack = 3
    hard_attack = 7
    ap_attack = 25
    air_attack = 19

    #Space taken in convoy
    lend_lease_cost = 3

    build_cost_ic = 4
    resources = {
        steel = 2
    }

	equipment anti_air_equipment_1 available from 1936 #because anti_air_equipment_1 is inside of anti_air_equipment we know anti_air_equipment_1 uses anti_air_equipment as its archtype
		name "My cool equipment"
        desc "My verry long description"
        short desc "cool desc"

        name for GER "My cool equipment"
        desc for GER "My verry long description"
        short desc for GER "cool desc"

        priority = 80
		visual_level = 0

        equipment anti_air_equipment_2 available from 1940 # clearly parent = anti_air_equipment_1 archetype = anti_air_equipment
            name "My cool equipment2"
            desc "My verry long description2"
            short desc "cool desc2"

            name for GER "My cool equipment2"
            desc for GER "My verry long description2"
            short desc for GER "cool desc2"
            
            priority = 80
            visual_level = 1
            
            soft_attack = 3.5
            hard_attack = 11
            ap_attack = 60
            air_attack = 25

            build_cost_ic = 5
            resources = {
                steel = 2
            }